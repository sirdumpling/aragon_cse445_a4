<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" targetNamespace="https://sirdumpling.github.io/aragon_cse445_a4"
	xmlns="https://sirdumpling.github.io/aragon_cse445_a4" elementFormDefault="qualified">

  <!-- National Parks root element -->
  <xs:element name="NationalParks">
    <xs:complexType>
      <xs:sequence>
		
		<!-- National park first child element -->
		 <xs:element name="NationalPark" minOccurs="1" maxOccurs="unbounded">
		  <xs:complexType>
			  <xs:sequence>
				  <xs:element name="Name" type="xs:string" maxOccurs="1"/>
				  
				  <xs:element name="Phone" type="PhoneType" minOccurs="1" maxOccurs="unbounded"/>
				
				  <!--Address element has many children. Let's put them into a structures sequence left to right.-->
				  <xs:element name="Address">
					  <xs:complexType>
						  <xs:sequence>
							  <xs:element name="Number" type="xs:integer"/>
							  <xs:element name="Street" type="xs:string"/>
							  <xs:element name="City" type="xs:string"/>
							  <xs:element name="State" type="xs:string"/>
							  <xs:element name="Zip" type="ZipType"/>
						  </xs:sequence>
						  <xs:attribute name="NearestAirport" type="xs:string" use="required"/>
					  </xs:complexType>
				  </xs:element>
			  </xs:sequence>
			  
			<xs:attribute name="Rating" type="xs:decimal" use="optional"/>
			
		  </xs:complexType>
		</xs:element>	
      </xs:sequence>
    </xs:complexType>
  </xs:element>
	
	<!--Defining restrictions on PhoneType and ZipType (from example code in the assignment PDF)-->
	<xs:simpleType name="PhoneType">
		<xs:restriction base="xs:string">
			<xs:pattern value="\d{3}\-\d{3}\-\d{4}"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="ZipType">
		<xs:restriction base="xs:string">
			<!--<xs:totalDigits value="5"/>
			<xs:pattern value="\d{5}"/>-->
		</xs:restriction>
	</xs:simpleType>
	
</xs:schema>

